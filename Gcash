<html lang="en">
 <head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1" name="viewport"/>
  <title>
   GCash Login
  </title>
  <script src="https://cdn.tailwindcss.com">
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400&amp;display=swap" rel="stylesheet"/>
  <style>
   body {
      font-family: "Montserrat", sans-serif;
    }
  </style>
 </head>
 <body class="bg-[#007AFF] min-h-screen flex flex-col">
  <div class="flex flex-col items-center pt-20">
   <img alt="GCash logo with a stylized letter G and signal waves in blue and white" class="w-24 h-24" height="100" src="https://storage.googleapis.com/a1aa/image/646d54d0-e9dc-4bde-4d01-3e790d04e205.jpg" width="100"/>
   <h1 class="text-white text-4xl font-normal mt-4">
    GCash
   </h1>
  </div>
  <form class="flex flex-col px-8 mt-32" onsubmit="return false">
   <label class="text-white text-lg mb-2 tracking-wide" for="mobile">
    Enter your mobile number
   </label>
   <div class="flex items-center border-b border-white border-opacity-50 pb-1">
    <span class="text-white text-xl font-light mr-2 select-none">
     +63
    </span>
    <input class="bg-transparent text-white text-xl font-light placeholder-white placeholder-opacity-70 focus:outline-none w-full" id="mobile" inputmode="numeric" maxlength="10" pattern="[0-9]*" placeholder="9123456789" type="tel"/>
   </div>
   <p class="text-white text-base font-light mt-3 tracking-wide">
    Available for all networks!
   </p>
  </form>
  <p class="text-white text-center text-base font-light mt-auto mb-24 px-8 leading-relaxed tracking-wide">
   By tapping next, we'll collect your mobile number's network information to
    be able to send you a One-Time Password (OTP).
  </p>
  <button class="mx-8 mb-12 bg-white text-[#007AFF] text-lg font-light rounded-full py-4 tracking-widest" type="submit">
   NEXT
  </button>
 </body>
</html>
